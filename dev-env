#!/usr/bin/env bash
dry_run="0"

if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

if [[ $1 == "--dry" ]]; then
    dry_run="1"
fi

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

log "deploying dotfiles from: $DEV_ENV"

current_theme=""
if [ -L "$XDG_CONFIG_HOME/colors/current" ]; then
    current_theme="$(basename "$(readlink "$XDG_CONFIG_HOME/colors/current")")"
    log "active theme to preserve: $current_theme"
fi

update_files() {
    log "syncing tree: $1 -> $2"
    pushd "$1" &>/dev/null
    (
        configs=$(find . -type f -printf '%h\n' | sort -u | awk '
            { keep = 1
              for (p in seen) if (index($0, p "/") == 1) { keep = 0; break }
              if (keep) { print; seen[$0] = 1 } }')

        for c in $configs; do
            rel=${c#./}
            directory=${2%/}/$rel
            parent=$(dirname "$directory")
            log "    replacing: $directory"

            if [[ $dry_run == "0" ]]; then
                # Atomic swap: the target always exists (old version or
                # new version, never missing), so watchers (hyprland) never
                # see a missing file and never show "cannot open".
                # Only top-level entries are held (sockets, plugin
                # state and session state always live at the target
                # root), so holding and restoring are a few renames,
                # never a full tree walk.
                # The hold dir MUST live next to the target (same
                # filesystem): mv across filesystems "copies" a socket
                # into a dead file instead of moving the live inode.
                mkdir -p "$parent"
                sockhold=""
                preserve=""
                if [ -d "$directory" ]; then
                    for p in plugins plugins.json session.json session-snapshots; do
                        [ -e "$directory/$p" ] && preserve="$preserve $p"
                    done
                    while IFS= read -r s; do
                        preserve="$preserve $s"
                    done < <(find "$directory" -maxdepth 1 -type s -printf '%f\n' 2>/dev/null)
                    if [ -n "$preserve" ]; then
                        sockhold=$(mktemp -d "$parent/.deploy-hold-XXXXXX")
                        for name in $preserve; do
                            mv "$directory/$name" "$sockhold/$name"
                        done
                    fi
                fi
                tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/deploy.XXXXXX")
                cp -r "./$rel/." "$tmpdir/"
                mkdir -p "$parent"
                bak="$directory.deploy-bak-$$"
                rm -rf "$bak"
                [ -e "$directory" ] && mv "$directory" "$bak"
                mv "$tmpdir" "$directory"
                rm -rf "$bak"
                if [ -n "$sockhold" ]; then
                    for held in "$sockhold"/*; do
                        [ -e "$held" ] || continue
                        name=${held##*/}
                        rm -rf "$directory/$name"
                        mv "$held" "$directory/$name"
                    done
                    rm -rf "$sockhold"
                fi
            fi

            log "    copying: $rel -> $parent/"
        done

    )
    popd &>/dev/null
}

copy() {
    log "replacing file: $2"
    if [[ $dry_run == "0" ]]; then
        rm "$2"
    fi
    log "    copying: $1 -> $2"
    if [[ $dry_run == "0" ]]; then
        cp "$1" "$2"
    fi
}

# Hyprland reloads the config when it detects changes. Disable autoreload
# to stop it from reading the tree in the middle of the deploy (rm -rf + copy)
# and showing the "cannot open hyprland.lua" popup.
prev_autoreload="false"
if [[ $dry_run == "0" ]]; then
    prev_autoreload=$(hyprctl getoption misc:disable_autoreload 2>/dev/null | awk '/^bool:/{print $2}')
    [ -z "$prev_autoreload" ] && prev_autoreload="false"
    hyprctl keyword misc:disable_autoreload 1 >/dev/null 2>&1 || true
    trap 'hyprctl keyword misc:disable_autoreload "$prev_autoreload" >/dev/null 2>&1 || true' EXIT
fi

update_files "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
update_files "$DEV_ENV/env/.local" "$HOME/.local"
copy "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
cp -r "$DEV_ENV/env/.vim/" "$HOME/"
copy "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
copy "$DEV_ENV/dev-env" "$HOME/.local/scripts/dev-env"

if [ -n "$current_theme" ]; then
    log "restoring theme: $current_theme"
    if [[ $dry_run == "0" ]]; then
        "$HOME/.local/libexec/theme-switch" "$current_theme"
    fi
fi

if [[ $dry_run == "0" ]]; then
    hyprctl reload
    pkill -x waybar >/dev/null 2>&1 || true
    nohup waybar -c "$XDG_CONFIG_HOME/waybar/config.jsonc" >/dev/null 2>&1 & disown
    hyprshade on ~/.config/hypr/shaders/digital-vibrance.glsl
fi
