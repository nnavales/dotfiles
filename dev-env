#!/usr/bin/env bash
dry_run="0"

if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

if [[ $1 == "--dry" ]]; then
    dry_run="1"
fi

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

log "deploying dotfiles from: $DEV_ENV"

current_theme=""
if [ -L "$XDG_CONFIG_HOME/colors/current" ]; then
    current_theme="$(basename "$(readlink "$XDG_CONFIG_HOME/colors/current")")"
    log "active theme to preserve: $current_theme"
fi

update_files() {
    log "syncing tree: $1 -> $2"
    pushd "$1" &>/dev/null
    (
        configs=$(find . -type f -printf '%h\n' | sort -u | awk '
            { keep = 1
              for (p in seen) if (index($0, p "/") == 1) { keep = 0; break }
              if (keep) { print; seen[$0] = 1 } }')

        for c in $configs; do
            rel=${c#./}
            directory=${2%/}/$rel
            parent=$(dirname "$directory")
            log "    replacing: $directory"

            if [[ $dry_run == "0" ]]; then
                rm -rf "$directory"
            fi

            log "    copying: $rel -> $parent/"
            if [[ $dry_run == "0" ]]; then
                mkdir -p "$parent"
                cp -r "./$rel" "$parent/"
            fi
        done

    )
    popd &>/dev/null
}

copy() {
    log "replacing file: $2"
    if [[ $dry_run == "0" ]]; then
        rm "$2"
    fi
    log "    copying: $1 -> $2"
    if [[ $dry_run == "0" ]]; then
        cp "$1" "$2"
    fi
}

update_files "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
update_files "$DEV_ENV/env/.local" "$HOME/.local"
copy "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
cp -r "$DEV_ENV/env/.vim/" "$HOME/"
copy "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
copy "$DEV_ENV/dev-env" "$HOME/.local/scripts/dev-env"

if [ -n "$current_theme" ]; then
    log "restoring theme: $current_theme"
    if [[ $dry_run == "0" ]]; then
        "$XDG_CONFIG_HOME/colors/scripts/theme-switch.sh" "$current_theme"
    fi
fi

if [[ $dry_run == "0" ]]; then
    hyprctl reload
    pkill -x waybar >/dev/null 2>&1 || true
    nohup waybar >/dev/null 2>&1 & disown
    hyprshade on ~/.config/hypr/shaders/digital-vibrance.glsl
fi
