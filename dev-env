#!/usr/bin/env bash
dry_run="0"

if [ -z "${XDG_CONFIG_HOME:-}" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME="$HOME/.config"
fi

if [ -z "${DEV_ENV:-}" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

if ! command -v rsync >/dev/null 2>&1; then
    echo "rsync is required"
    exit 1
fi

if [[ ${1:-} == "--dry" ]]; then
    dry_run="1"
fi

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

log "deploying dotfiles from: $DEV_ENV"

current_theme=""
if [ -L "$XDG_CONFIG_HOME/colors/current" ]; then
    current_theme="$(basename "$(readlink "$XDG_CONFIG_HOME/colors/current")")"
    log "active theme to preserve: $current_theme"
fi

changed_hypr="0"
changed_waybar="0"
changed_colors="0"

sync_entry() {
    local src="$1"
    local dst="$2"
    local mode="${3:-additive}"
    shift 3 || true
    local out line path sock meaningful
    local -a rsync_args=("$@")

    log "syncing: $src -> $dst ($mode)"
    if [ ! -e "$src" ]; then
        return
    fi

    rsync_args+=(-a -i --exclude='/plugins' --exclude='/plugins.json'
        --exclude='/session.json' --exclude='/session-snapshots')
    if [[ $mode == "delete" ]]; then
        rsync_args+=(--delete)
    fi
    if [[ $dry_run == "1" ]]; then
        rsync_args+=(--dry-run)
    fi

    if [ -d "$dst" ]; then
        while IFS= read -r sock; do
            [ -n "$sock" ] || continue
            rsync_args+=(--exclude="/$sock")
        done < <(find "$dst" -maxdepth 1 -type s -printf '%f\n' 2>/dev/null)
    fi

    if [ -d "$src" ]; then
        if [[ $dry_run == "0" ]]; then
            mkdir -p "$dst"
        fi
        out=$(rsync "${rsync_args[@]}" "$src/" "$dst/" 2>&1)
    elif [[ $dry_run == "1" ]]; then
        out=$(rsync -a -i --dry-run "$src" "$dst" 2>&1)
    else
        mkdir -p "$(dirname "$dst")"
        out=$(rsync -a -i "$src" "$dst" 2>&1)
    fi

    if [ -z "$out" ]; then
        return
    fi
    if [[ $dry_run == "1" ]]; then
        log "$out"
        return
    fi
    meaningful=""
    while IFS= read -r line; do
        path="${line:12}"
        [[ $path == "./" ]] && continue
        meaningful=1
        case "$dst/$path" in
        "$XDG_CONFIG_HOME/hypr"*) changed_hypr="1" ;;
        "$XDG_CONFIG_HOME/waybar"*) changed_waybar="1" ;;
        "$XDG_CONFIG_HOME/colors"*) changed_colors="1" ;;
        esac
    done <<<"$out"
    if [ -z "$meaningful" ]; then
        return
    fi
    log "    updated: $src"
    log "$(echo "$out" | head -20)"
}

sync_tree() {
    local src="$1"
    local dst="$2"
    local mode="${3:-additive}"
    local entry name
    local -a entry_extra

    if [ ! -e "$src" ]; then
        return
    fi
    shopt -s nullglob
    for entry in "$src"/*; do
        name="${entry##*/}"
        entry_extra=()
        if [[ $name == "colors" && $dst == "$XDG_CONFIG_HOME" && -L "$dst/$name/current" ]]; then
            entry_extra=(--exclude='/current')
        fi
        sync_entry "$entry" "${dst%/}/$name" "$mode" "${entry_extra[@]}"
    done
    shopt -u nullglob
}

sync_file() {
    log "replacing file: $2"
    if [[ $dry_run == "1" ]]; then
        log "    copying: $1 -> $2"
        return
    fi
    if [ -e "$2" ] && cmp -s "$1" "$2"; then
        return
    fi
    log "    copying: $1 -> $2"
    cp "$1" "$2"
}

prev_autoreload="false"
if [[ $dry_run == "0" ]]; then
    prev_autoreload=$(hyprctl getoption misc:disable_autoreload 2>/dev/null | awk '/^bool:/{print $2}')
    [ -z "$prev_autoreload" ] && prev_autoreload="false"
    hyprctl keyword misc:disable_autoreload 1 >/dev/null 2>&1 || true
    trap 'hyprctl keyword misc:disable_autoreload "$prev_autoreload" >/dev/null 2>&1 || true' EXIT
fi

sync_tree "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME" delete
shopt -s nullglob
for local_entry in "$DEV_ENV/env/.local"/*; do
    entry_name="${local_entry##*/}"
    if [[ $entry_name == "share" ]]; then
        sync_tree "$local_entry" "$HOME/.local/share" additive
    elif [[ $entry_name == "scripts" ]]; then
        sync_entry "$local_entry" "$HOME/.local/$entry_name" delete --exclude='/dev-env'
    else
        sync_entry "$local_entry" "$HOME/.local/$entry_name" delete
    fi
done
shopt -u nullglob
sync_file "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
sync_tree "$DEV_ENV/env/.vim" "$HOME/.vim" additive
sync_file "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
sync_file "$DEV_ENV/dev-env" "$HOME/.local/scripts/dev-env"

if [ -n "$current_theme" ] && [[ $changed_colors == "1" || $dry_run == "1" ]]; then
    log "restoring theme: $current_theme"
    if [[ $dry_run == "0" ]]; then
        "$HOME/.local/libexec/theme-switch" "$current_theme"
    fi
fi

if [[ $dry_run == "0" ]]; then
    if [[ $changed_hypr == "1" ]]; then
        hyprctl reload
    fi
    if [[ $changed_waybar == "1" ]]; then
        pkill -x waybar >/dev/null 2>&1 || true
        nohup waybar -c "$XDG_CONFIG_HOME/waybar/config.jsonc" >/dev/null 2>&1 &
        disown
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "dev-env" -u normal "dev-env" "Dotfiles deployed successfully"
    fi
fi
