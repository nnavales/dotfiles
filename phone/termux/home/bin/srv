#!/data/data/com.termux/files/usr/bin/bash
# srv — reliably bring up the Termux server
# Usage: srv   (after rebooting the phone, or whenever needed)

termux-wake-lock
if pgrep -x sshd >/dev/null 2>&1; then
  echo "sshd was already running (pid $(pgrep -x sshd | head -1))"
else
  sshd
  sleep 1
  echo "sshd started (pid $(pgrep -x sshd | head -1))"
fi
ip=$(ifconfig 2>/dev/null | awk '/^wlan0:/{f=1;next} f&&/inet /{print $2; exit}')
echo "IP: ${ip:-unknown}  port 8022"
