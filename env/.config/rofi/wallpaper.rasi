@import "~/.config/rofi/theme.rasi"

* {
  background-color: transparent;
  text-color: @fg;
  font: "GeistMono Nerd Font Medium 11";
  spacing: 0;
}

window {
  background-color: @bg-alt;
  border: 1px solid;
  border-color: @border;
  border-radius: 16px;
  padding: 0;
  width: 720px;
  location: center;
  anchor: center;
}

mainbox {
  padding: 10px;
  spacing: 8px;
  border: 0;
}

inputbar {
  padding: 10px 14px;
  spacing: 10px;
  background-color: @bg;
  border: 1px solid;
  border-color: @input-border;
  border-radius: 12px;
  margin: 0;
  children: [ prompt, entry ];
}

prompt {
  enabled: true;
  text-color: @accent;
  font: "GeistMono Nerd Font Medium 11";
  vertical-align: 0.5;
}

entry {
  text-color: @fg;
  placeholder-color: @muted;
  placeholder: "";
  vertical-align: 0.5;
}

listview {
  padding: 2px;
  spacing: 8px;
  columns: 4;
  lines: 2;
  fixed-height: true;
  scrollbar: false;
  border: 0;
  flow: horizontal;
  dynamic: false;
}

element {
  orientation: vertical;
  padding: 8px;
  spacing: 8px;
  border: 1px solid;
  border-color: transparent;
  border-radius: 10px;
  background-color: @bg;
  text-color: @fg;
}

element normal.normal {
  background-color: @bg;
  text-color: @fg;
}

element selected.normal {
  background-color: @bg-selected;
  text-color: #ffffff;
  border-color: @accent;
}

element-icon {
  background-color: transparent;
  size: 7em;
  border-radius: 8px;
  horizontal-align: 0.5;
  vertical-align: 0.5;
}

element-text {
  background-color: transparent;
  text-color: @muted;
  font: "GeistMono Nerd Font 10";
  horizontal-align: 0.5;
  vertical-align: 0.5;
}
