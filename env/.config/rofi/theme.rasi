* {
  bg:           #1b1b1b;
  fg:           #dce5e5;
  bg-selected:  #303030;
  bg-alt:       #161616;
  border:       #2a2a2a;
  input-border: #222222;
  prompt:       #a1deea;
  info:         #626262;
  highlight:    #eca25c;
  marker:       #5aa6e6;
  /* ── aliases nuevos (los viejos siguen funcionando) ── */
  accent:       #a1deea;
  muted:        #626262;
  subtle:       #5c5c5c;
  sel-border:   #2a2a2a;
  urgent:       #e87777;
  warning:      #e0b074;
}
