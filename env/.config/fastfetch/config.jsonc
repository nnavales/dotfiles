{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "arch2",
    "color": {
      "1": "#6B7D7F",
      "2": "#6B7D7F"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#6B7D7F",
      "title": "white"
    },
    "brightColor": false
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}\u001b[38;2;107;125;127m@{host-name-colored}"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "theme",
    "icons",
    "font",
    "cursor",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
